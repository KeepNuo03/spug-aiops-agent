# LLM (DeepSeek speaks the OpenAI protocol)
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
# Language the model writes diagnoses in: en or zh
DIAGNOSIS_LANGUAGE=en

# Spug (runtime dependency, called over HTTP only — see LICENSE boundary notice in README)
SPUG_BASE_URL=http://host.docker.internal:8080
SPUG_USERNAME=admin
SPUG_PASSWORD=spug.dev

# Metrics / tools
PROMETHEUS_URL=http://prometheus:9090
MCP_SERVER_URL=http://mcp_server:8765/mcp

# State: Redis holds graph checkpoints, Postgres holds incidents and the approval audit trail
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://aiops:aiops.local@postgres:5432/aiops
INCIDENT_RETENTION_DAYS=7
INCIDENT_RETENTION_COUNT=200

# Runtime state
CHECKPOINT_TTL_MINUTES=10080
